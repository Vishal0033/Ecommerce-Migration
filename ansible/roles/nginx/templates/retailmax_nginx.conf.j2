# RetailMax Nginx Blue-Green Reverse Proxy Configuration
# Managed by Ansible - DO NOT EDIT MANUALLY

upstream retailmax_backend {
{% if active_slot == 'blue' %}
    # Slot Blue Active (Primary)
    server 127.0.0.1:{{ blue_port }} max_fails=3 fail_timeout=10s;
{% else %}
    # Slot Green Active (Cutover)
    server 127.0.0.1:{{ green_port }} max_fails=3 fail_timeout=10s;
{% endif %}
}

server {
    listen 80;
    server_name _;

    # AWS ALB & Automated Health Check
    location /health {
        proxy_pass http://retailmax_backend/health;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
        access_log off;
    }

    # Prometheus Scraping Endpoint
    location /metrics {
        proxy_pass http://retailmax_backend/metrics;
        proxy_set_header Host $host;
    }

    # API Proxy to Monolith Backend
    location /api/ {
        proxy_pass http://retailmax_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend Single Page App Proxy
    location / {
        proxy_pass http://127.0.0.1:3030;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

