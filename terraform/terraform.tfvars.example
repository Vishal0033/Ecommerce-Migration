# Example Terraform Variables
# Copy to terraform.tfvars and adapt to your credentials

aws_region         = "us-east-1"
environment        = "production"
project_name       = "retailmax"
instance_type      = "t3.medium"
key_name           = "retailmax-aws-key"
admin_cidr_blocks  = ["0.0.0.0/0"]

db_instance_class  = "db.t3.micro"
db_allocated_storage = 20
db_name            = "retailmax_db"
db_username        = "retailmax_admin"
db_password        = "RetailMaxSecurePass2026!"
